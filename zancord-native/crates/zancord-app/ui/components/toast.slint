// Toast v3 — flat charcoal pill with a colored status dot (PWA style).

import { Theme } from "../theme.slint";

export component ToastCard inherits Rectangle {
    in property <string> text;
    in property <string> kind; // "info" | "success" | "warning" | "error"

    function kind_color(kind: string) -> color {
        if kind == "error" { return Theme.error; }
        if kind == "warning" { return Theme.warning; }
        if kind == "success" { return Theme.success; }
        return Theme.accent;
    }

    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.bg-secondary;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: Theme.shadow-y;
    drop-shadow-blur: Theme.shadow-blur-sm;
    drop-shadow-color: Theme.shadow-color;

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        padding-top: Theme.spacing-sm;
        padding-bottom: Theme.spacing-sm;
        spacing: Theme.spacing-sm;
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.kind_color(root.kind);
        }
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
