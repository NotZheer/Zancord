// Control dock v3 — mirrors the PWA: flat circular icon buttons with text
// labels, off = muted, on = blurple, leave = red. No glass pill.

import { Theme } from "../theme.slint";
import { MicIcon, MicOffIcon, CameraIcon, CameraOffIcon, ScreenIcon, HeadphonesIcon, HeadphonesOffIcon, PhoneIcon } from "icons.slint";

component DockButton inherits Rectangle {
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked();

    width: 56px;
    height: 56px;
    border-radius: 28px;
    background: root.danger ? #f23f4214 : (root.active ? Theme.accent : Theme.bg-card);
    border-width: 1px;
    border-color: root.danger ? #f23f4259 : (root.active ? transparent : Theme.border);
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    states [
        hover when touch.has-hover && !touch.pressed: {
            background: root.danger ? #f23f4229 : (root.active ? Theme.accent-strong : Theme.bg-hover);
        }
        pressed when touch.pressed: {
            background: root.danger ? #f23f4233 : Theme.accent-strong;
        }
    ]
}

export component ControlDock inherits Rectangle {
    in property <bool> mic_enabled;
    in property <bool> camera_enabled;
    in property <bool> screen_sharing;
    in property <bool> deafened;

    callback toggle_mic();
    callback toggle_camera();
    callback toggle_screen_share();
    callback toggle_deafen();
    callback leave_room();

    background: transparent;

    HorizontalLayout {
        spacing: Theme.spacing-md;
        alignment: center;

        // Each button is a column: circle + label.
        Rectangle {
            width: 72px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                DockButton {
                    active: root.mic_enabled;
                    clicked => { root.toggle_mic(); }
                    if root.mic_enabled: MicIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: #ffffff;
                    }
                    if !root.mic_enabled: MicOffIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.text-secondary;
                    }
                }
                Text {
                    text: "Mic";
                    color: root.mic_enabled ? Theme.text-primary : Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle {
            width: 72px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                DockButton {
                    active: root.camera_enabled;
                    clicked => { root.toggle_camera(); }
                    if root.camera_enabled: CameraIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: #ffffff;
                    }
                    if !root.camera_enabled: CameraOffIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.text-secondary;
                    }
                }
                Text {
                    text: "Camera";
                    color: root.camera_enabled ? Theme.text-primary : Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle {
            width: 72px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                DockButton {
                    active: root.screen_sharing;
                    clicked => { root.toggle_screen_share(); }
                    ScreenIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: root.screen_sharing ? #ffffff : Theme.text-secondary;
                    }
                }
                Text {
                    text: "Screen";
                    color: root.screen_sharing ? Theme.text-primary : Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle {
            width: 72px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                DockButton {
                    active: root.deafened;
                    clicked => { root.toggle_deafen(); }
                    if root.deafened: HeadphonesOffIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: #ffffff;
                    }
                    if !root.deafened: HeadphonesIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.text-secondary;
                    }
                }
                Text {
                    text: "Deafen";
                    color: root.deafened ? Theme.text-primary : Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle {
            width: 72px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                DockButton {
                    danger: true;
                    clicked => { root.leave_room(); }
                    PhoneIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.error;
                    }
                }
                Text {
                    text: "Leave";
                    color: Theme.error;
                    font-size: Theme.font-size-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
