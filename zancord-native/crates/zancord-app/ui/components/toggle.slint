// Toggle v3 — flat blurple switch (PWA style): accent fill when on.

import { Theme } from "../theme.slint";

export component Toggle inherits Rectangle {
    in property <bool> active: false;
    callback clicked();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.active ? transparent : Theme.border-strong;
    background: root.active ? Theme.accent : Theme.bg-secondary;
    animate background { duration: 120ms; }

    Rectangle {
        x: root.active ? parent.width - 20px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: 120ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}
