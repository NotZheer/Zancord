// Join screen v3 — flat charcoal like the PWA: centered card, ghost inputs,
// blurple join button.

import { Theme } from "../theme.slint";

// Field shell: label + rounded input with a focus ring.
component Field inherits Rectangle {
    in property <string> label;
    in property <string> text;
    callback edited(string);

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-size-sm;
    }
    Rectangle {
        height: 44px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        background: Theme.bg-secondary;
        animate border-color { duration: 100ms; }
        HorizontalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            input := TextInput {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                text: root.text;
                color: Theme.text-primary;
                font-size: Theme.font-size-md;
                accepted => { root.edited(self.text); }
            }
        }
    }
}

export component JoinScreen inherits Rectangle {
    in-out property <string> endpoint;
    in-out property <string> room;
    in-out property <string> username;
    // Non-empty shows as an error banner (join failures from Rust).
    in property <string> error;
    callback join_clicked(string, string, string);

    background: Theme.bg-primary;

    property <bool> ready:
        !root.endpoint.is_empty && !root.room.is_empty && !root.username.is_empty;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 440px;
                border-radius: Theme.radius-lg;
                background: Theme.bg-card;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.spacing-lg;
                    spacing: Theme.spacing-md;

                    Text {
                        text: "Zancord";
                        color: Theme.text-primary;
                        font-size: 34px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: "Peer-to-peer voice, video & screen share over Tailscale";
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Field {
                        label: "SIGNALING SERVER";
                        text: root.endpoint;
                        edited(value) => { root.endpoint = value; }
                    }

                    Field {
                        label: "ROOM";
                        text: root.room;
                        edited(value) => { root.room = value; }
                    }

                    Field {
                        label: "DISPLAY NAME";
                        text: root.username;
                        edited(value) => { root.username = value; }
                    }

                    if root.error != "": Rectangle {
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.error;
                        background: #f23f4214;
                        VerticalLayout {
                            padding: Theme.spacing-sm;
                            Text {
                                text: root.error;
                                color: Theme.error;
                                font-size: Theme.font-size-sm;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-sm;
                        background: root.ready ? Theme.accent : Theme.bg-secondary;
                        border-width: 1px;
                        border-color: root.ready ? transparent : Theme.border;
                        join_touch := TouchArea {
                            enabled: root.ready;
                            clicked => { root.try_join(); }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: "Join";
                            color: root.ready ? #ffffff : Theme.text-faint;
                            font-size: Theme.font-size-md;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        states [
                            hover when join_touch.has-hover && root.ready: { background: Theme.accent-strong; }
                        ]
                    }
                }
            }
        }
    }

    function try_join() {
        if root.ready {
            root.join_clicked(root.endpoint, root.room, root.username);
        }
    }
}
