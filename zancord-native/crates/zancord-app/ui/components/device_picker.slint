// DevicePicker v3 — flat dropdown: current device, chevron, hover states.

import { Theme } from "../theme.slint";

export component DevicePicker inherits Rectangle {
    in property <[string]> devices;
    in property <string> current;
    callback selected(int);
    property <bool> open: false;

    width: 100%;
    height: 34px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.open ? Theme.accent : Theme.border;
    background: Theme.bg-secondary;
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: Theme.spacing-sm;
        padding-right: Theme.spacing-sm;
        spacing: Theme.spacing-xs;
        alignment: center;
        Text {
            text: root.current;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: root.open ? "▴" : "▾";
            color: Theme.text-faint;
            font-size: Theme.font-size-xs;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.open = !root.open; }
        mouse-cursor: pointer;
    }
    states [
        hover when touch.has-hover && !root.open: { background: Theme.bg-hover; }
    ]

    if root.open: Rectangle {
        y: 36px;
        width: 100%;
        border-radius: Theme.radius-sm;
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: Theme.shadow-y;
        drop-shadow-blur: Theme.shadow-blur-sm;
        drop-shadow-color: Theme.shadow-color;
        VerticalLayout {
            padding: Theme.spacing-xs;
            spacing: 2px;
            for d[idx] in root.devices: Rectangle {
                width: 100%;
                border-radius: Theme.radius-sm;
                Text {
                    text: d;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                pick := TouchArea {
                    clicked => {
                        root.selected(idx);
                        root.open = false;
                    }
                    mouse-cursor: pointer;
                }
                states [
                    hover when pick.has-hover: { background: Theme.bg-hover; }
                ]
            }
        }
    }
}
