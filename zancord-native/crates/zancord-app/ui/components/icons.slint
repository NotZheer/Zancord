// Zancord icon set: crisp monochrome line icons (Feather-style, 24×24 grid)
// drawn with Path elements. Every icon takes a `tint` so states can recolor.

import { Theme } from "../theme.slint";

// Shared stroke defaults.
component IconBase inherits Path {
    in property <color> tint: Theme.text-secondary;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.8px;
    stroke-line-cap: LineCap.round;
    stroke-line-join: LineJoin.round;
    width: 22px;
    height: 22px;
}

export component MicIcon inherits IconBase {
    commands: "M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z M19 10v2a7 7 0 0 1-14 0v-2 M12 19v3 M8 23h8";
}

