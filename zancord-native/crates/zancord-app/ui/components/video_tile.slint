// Video tile (Phase 4.3): remote/local video with avatar fallback, username
// overlay, muted indicator, screen-share badge, and a speaking ring.

import { Theme } from "../theme.slint";
import { ZSlider } from "slider.slint";

export component VideoTile inherits Rectangle {
    in property <string> username;
    in property <string> initial;
    in property <image> frame;
    in property <bool> is_speaking;
    in property <bool> is_muted;
    in property <bool> has_video;
    in property <bool> is_screen_share;
    in property <string> connection_state;
    in property <string> peer_id;
    in property <float> volume: 1.0;
    property <bool> volume_visible: false;
    // Local slider state (seeded from `volume`).
    property <float> vol: 1.0;
    init => { self.vol = root.volume; }
    callback volume_changed(string, float);

    function connection_color(state: string) -> color {
        if state == "connected" { return Theme.success; }
        if state == "failed" || state == "disconnected" { return Theme.error; }
        return Theme.warning; // connecting / unknown
    }

    border-radius: Theme.radius-md;
    border-width: 2px;
    border-color: root.is_speaking ? Theme.accent : Theme.border;
    animate border-color { duration: 400ms; }
    background: Theme.bg-secondary;
    clip: true;
    min-width: 240px;
    min-height: 160px;

    // Video (or avatar fallback).
    Image {
        source: root.frame;
        visible: root.has_video;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
    if !root.has_video: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: Theme.accent;
                Text {
                    text: root.initial == "" ? "?" : root.initial;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-xl;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Bottom overlay: username + status badges.
    Rectangle {
        y: parent.height - 36px;
        height: 36px;
        width: 100%;
        background: #0f0f1780;
        HorizontalLayout {
            padding-left: Theme.spacing-sm;
            padding-right: Theme.spacing-sm;
            spacing: Theme.spacing-xs;
            alignment: center;
            Text {
                text: root.username;
                color: Theme.text-primary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            Text {
                text: root.is_muted ? "🔇" : "";
                color: Theme.error;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // Connection indicator: green connected, amber connecting,
            // red failed/disconnected (a Text dot so it centers like the
            // other badges).
            Text {
                text: "●";
                color: root.connection_color(root.connection_state);
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            Text {
                text: root.is_screen_share ? "🖥️" : "";
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            // Per-peer volume control (opens a mini slider).
            Text {
                text: "🔊";
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
                vol_touch := TouchArea {
                    clicked => { root.volume_visible = !root.volume_visible; }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // Volume popover: free-positioned above the overlay (not in a layout).
    if root.volume_visible: Rectangle {
        x: (parent.width - 150px) / 2;
        y: parent.height - 90px;
        width: 150px;
        height: 36px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-surface;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding: Theme.spacing-xs;
            spacing: Theme.spacing-xs;
            Text {
                text: "🔊";
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            ZSlider {
                value: root.vol;
                min: 0.0;
                max: 2.0;
                changed(v) => {
                    root.vol = v;
                    root.volume_changed(root.peer_id, v);
                }
            }
            Text {
                text: Math.round(root.vol * 100.0);
                color: Theme.text-primary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
        }
    }
}
