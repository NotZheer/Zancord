// Chat panel v3 — PWA-style right sidebar: flush panel, uppercase header,
// message bubbles, rounded input with a blurple send button.

import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { ChatMessage } from "../types.slint";
import { SendIcon } from "icons.slint";

export component ChatPanel inherits Rectangle {
    in property <[ChatMessage]> messages;
    callback send_chat(string);

    background: Theme.bg-card;

    // Left divider (Slint has no per-side borders).
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;

        Text {
            text: "CHAT";
            color: Theme.text-faint;
            font-size: Theme.font-size-xs;
            letter-spacing: 1.5px;
            font-weight: 700;
        }

        ListView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            for m in root.messages: HorizontalLayout {
                alignment: m.is_self ? end : start;
                Rectangle {
                    max-width: 250px;
                    border-radius: Theme.radius-md;
                    background: m.is_self ? Theme.accent-soft : Theme.bg-secondary;
                    border-width: 1px;
                    border-color: m.is_self ? Theme.accent : Theme.border;
                    VerticalLayout {
                        padding: Theme.spacing-sm;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            Text {
                                text: m.sender;
                                color: m.is_self ? Theme.accent : Theme.text-secondary;
                                font-size: Theme.font-size-xs;
                                font-weight: 700;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: m.timestamp;
                                color: Theme.text-faint;
                                font-size: Theme.font-size-xs;
                            }
                        }
                        Text {
                            text: m.content;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing-sm;
            Rectangle {
                horizontal-stretch: 1;
                height: 40px;
                border-radius: Theme.radius-pill;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.bg-secondary;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-sm;
                    input := TextInput {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        accepted => {
                            root.send_chat(self.text);
                            self.text = "";
                        }
                    }
                }
            }
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-pill;
                background: Theme.accent;
                touch := TouchArea {
                    clicked => {
                        root.send_chat(input.text);
                        input.text = "";
                    }
                    mouse-cursor: pointer;
                }
                SendIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 17px;
                    height: 17px;
                    stroke-width: 2px;
                    tint: #ffffff;
                }
                states [
                    hover when touch.has-hover: { background: Theme.accent-strong; }
                ]
            }
        }
    }
}
