// Zancord design system v3 — mirrors the PWA: Discord-style charcoal palette,
// blurple accent, hairline glass borders, flat surfaces (no gradients).
// Every component reads from this global so the whole UI re-themes in place.

export global Theme {
    // --- Surfaces (PWA tokens) ---
    out property <color> bg-primary: #1e1f22;    // window base
    out property <color> bg-secondary: #2b2d31;  // raised panels
    out property <color> bg-card: #232428;       // cards / tiles
    out property <color> bg-hover: #35373c;      // hover state
    out property <color> bg-overlay: #000000a6;  // scrims

    // --- Hairlines ---
    out property <color> border: #ffffff0f;
    out property <color> border-strong: #ffffff29;

    // --- Accent (blurple) + status (PWA tokens) ---
    out property <color> accent: #5865f2;
    out property <color> accent-strong: #4752c4;
    out property <color> accent-soft: #5865f229;
    out property <color> success: #23a55a;
    out property <color> warning: #f0b232;
    out property <color> error: #f23f42;

    // --- Text ---
    out property <color> text-primary: #f2f3f5;
    out property <color> text-secondary: #949ba4;
    out property <color> text-faint: #6d7178;

    // --- Typography (11 / 13 / 15 / 20 / 30) ---
    out property <length> font-size-xs: 11px;
    out property <length> font-size-sm: 13px;
    out property <length> font-size-md: 15px;
    out property <length> font-size-lg: 20px;
    out property <length> font-size-xl: 30px;

    // --- Spacing ---
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;

    // --- Radii (PWA tokens) ---
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-pill: 20px;

    // --- Depth ---
    out property <length> shadow-blur-sm: 10px;
    out property <length> shadow-blur-md: 24px;
    out property <length> shadow-blur-lg: 48px;
    out property <length> shadow-y: 4px;
    out property <color> shadow-color: #00000080;
    out property <color> glow-color: #5865f24d;

    // --- Brushes ---
    out property <brush> gradient-scrim: @linear-gradient(0deg, #000000b3 0%, #00000000 55%);
}
