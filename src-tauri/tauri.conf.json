{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZanCord",
  "version": "1.0.0",
  "identifier": "com.zancord.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZanCord | P2P Stream & Voice",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' wss: https: http: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Native P2P Voice and Video Call App",
    "longDescription": "Ultra high performance 1080p 60fps screen share & voice communication."
  }
}
